FROM python:3.12.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    AGENT_OUTPUT_DIR=/tmp/cardiac-ai-omop-agent-output

WORKDIR /app

RUN groupadd --gid 10001 agent \
    && useradd --uid 10001 --gid agent --no-create-home agent

COPY requirements.txt /app/requirements.txt
RUN python -m pip install --no-cache-dir --requirement requirements.txt

COPY --chown=agent:agent agent /app/agent
COPY --chown=agent:agent assets/ddl /app/assets/ddl
COPY --chown=agent:agent specs/target_schema /app/specs/target_schema
COPY --chown=agent:agent config.yaml /app/config.yaml

USER agent

CMD ["sh", "-c", "exec uvicorn agent.api:app --host 0.0.0.0 --port \"${PORT:-8000}\""]
