# Required only when running the HTTP API. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
ETL_AGENT_API_TOKEN=

# Deprecated migration fallback: AGENT_API_TOKEN. New deployments should use
# ETL_AGENT_API_TOKEN only.

# Optional local CLI credential when config.yaml selects provider: codex.
# Hosted OpenAI runs receive a transient per-run key from the UI instead.
OPENAI_API_KEY=

# Optional local CLI credential when config.yaml selects provider: anthropic.
# Hosted Claude runs receive a transient per-run key from the UI instead.
ANTHROPIC_API_KEY=
